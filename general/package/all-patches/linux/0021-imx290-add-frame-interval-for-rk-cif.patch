+static int imx290_g_frame_interval(struct v4l2_subdev *sd,
+				struct v4l2_subdev_frame_interval *fi)
+{
+	fi->interval.numerator = 1;
+	fi->interval.denominator = 60;
+	return 0;
+}
+
+static long imx290_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct imx290 *imx290 = to_imx290(sd);
+	long ret = 0;
+
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO: {
+		struct rkmodule_inf *inf = (struct rkmodule_inf *)arg;
+
+		memset(inf, 0, sizeof(*inf));
+		strlcpy(inf->base.sensor, "imx290", sizeof(inf->base.sensor));
+		strlcpy(inf->base.module,
+			imx290->module_name ? imx290->module_name : "imx462",
+			sizeof(inf->base.module));
+		strlcpy(inf->base.lens,
+			imx290->len_name ? imx290->len_name : "default",
+			sizeof(inf->base.lens));
+		break;
+	}
+	default:
+		ret = -ENOIOCTLCMD;
+		break;
+	}
+
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+static long imx290_compat_ioctl32(struct v4l2_subdev *sd,
+				  unsigned int cmd, unsigned long arg)
+{
+	void __user *up = compat_ptr(arg);
+	struct rkmodule_inf *inf;
+	long ret;
+
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO:
+		inf = kzalloc(sizeof(*inf), GFP_KERNEL);
+		if (!inf)
+			return -ENOMEM;
+
+		ret = imx290_ioctl(sd, cmd, inf);
+		if (!ret)
+			ret = copy_to_user(up, inf, sizeof(*inf));
+		kfree(inf);
+		break;
+	default:
+		ret = -ENOIOCTLCMD;
+		break;
+	}
+
+	return ret;
+}
+#endif
+
+static const struct v4l2_subdev_core_ops imx290_core_ops = {
+	.ioctl = imx290_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl32 = imx290_compat_ioctl32,
+#endif
+};
+
 static const struct v4l2_subdev_video_ops imx290_video_ops = {
 	.s_stream = imx290_set_stream,
+	.g_frame_interval = imx290_g_frame_interval,
 };
 
